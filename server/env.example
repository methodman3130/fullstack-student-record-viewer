# MongoDB connection string (local or Atlas).
MONGODB_URI=mongodb://127.0.0.1:27017/student-records

# Secret used to sign session tokens. Use a long random value in production.
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of browser origins allowed to call the API with credentials.
CLIENT_ORIGIN=http://localhost:5173

# Optional
PORT=5000
NODE_ENV=development
